{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steam-free-games-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "vars": {
    "STEAM_SEARCH_URL": "https://store.steampowered.com/search/?hwtype=0&maxprice=free&category1=998&specials=1&ndl=1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steam-free-games-bot",
      "database_id": "48beece7-1941-4665-9540-3b0e4cb56480",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "steam-free-games-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "steam-free-games-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "steam-free-games-notifications-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
